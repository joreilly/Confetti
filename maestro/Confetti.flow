# Shared by the Android and iOS apps: CI passes APP_ID with -e
appId: ${APP_ID}
---
- launchApp:
    clearState: true

- assertVisible: "Welcome to Confetti"
- tapOn: "Skip"

# A slow CI simulator can swallow the Skip tap, while Maestro, seeing the animated onboarding
# background change, still reports it as done. Give onboarding time to go, tap Skip again if
# it's still showing, then fail here (not in the conference-list wait) if it never goes.
- extendedWaitUntil:
    notVisible: "Welcome to Confetti"
    timeout: 15000
    optional: true
- runFlow:
    when:
      visible: "Welcome to Confetti"
    commands:
      - tapOn: "Skip"
- extendedWaitUntil:
    notVisible: "Welcome to Confetti"
    timeout: 15000

# Conferences and sessions come from the live Confetti backend, so allow for a slow network
# before scrolling: the list is newest-first, so KotlinConf drifts down as conferences are added.
# 60s because a fresh install retries the conference fetch up to 3 times, and a dropped TLS
# handshake on CI can take ~10s per attempt
- extendedWaitUntil:
    visible: "\\d{4}"
    timeout: 60000
- scrollUntilVisible:
    element: "KotlinConf 2026"
    direction: DOWN
    timeout: 30000
    centerElement: true
- tapOn: "KotlinConf 2026"

# The schedule: day tabs ("20 May, 2026") above the session list
- extendedWaitUntil:
    visible: "\\d{2} \\w+, \\d{4}"
    timeout: 30000
- assertVisible: "Schedule"
- takeScreenshot: Confetti
